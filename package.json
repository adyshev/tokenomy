{
  "name": "tokenomy-pi",
  "version": "0.2.0-beta.2",
  "description": "Automatic token-saving router for the Pi CLI using Pi's openai-codex provider, with visible local usage and quality evidence.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "routing",
    "token-economy",
    "token-saving",
    "model-router",
    "prompt-compression"
  ],
  "files": [
    ".pi/extensions/tokenomy",
    ".pi/tokenomy.json",
    ".pi/tokenomy.schema.json",
    "README.md",
    "INSTALL.md",
    "CONFIG.md",
    "COMPATIBILITY.md",
    "LIMITATIONS.md",
    "EVALUATION.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "scripts/live-evaluation.mjs",
    "scripts/economic-evaluation.mjs",
    "scripts/evaluation-core.mjs",
    "scripts/evaluation-scenarios.mjs",
    "scripts/catalog-check.mjs",
    "scripts/generate-config-schema.mjs",
    "tsconfig.json",
    "types/tokenshrink.d.ts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --loader ./tests/pi-extension-loader.mjs --test tests/*.test.mjs",
    "test:live": "node scripts/live-evaluation.mjs",
    "test:economic": "node scripts/economic-evaluation.mjs",
    "test:catalog": "node --experimental-strip-types scripts/catalog-check.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "schema:generate": "node --experimental-strip-types scripts/generate-config-schema.mjs",
    "schema:check": "node --experimental-strip-types scripts/generate-config-schema.mjs --check",
    "typecheck": "tsc -p tsconfig.json",
    "json:check": "node -e \"for (const f of ['.pi/tokenomy.json','.pi/tokenomy.schema.json','.pi/settings.json','package.json']) JSON.parse(require('fs').readFileSync(f,'utf8')); console.log('json ok')\"",
    "pi:check": "pi --offline --approve --no-session --list-models openai-codex"
  },
  "pi": {
    "extensions": [
      ".pi/extensions/tokenomy/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.82.1 <0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.82.1 <0.83.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adyshev/tokenomy.git"
  },
  "bugs": {
    "url": "https://github.com/adyshev/tokenomy/issues"
  },
  "homepage": "https://github.com/adyshev/tokenomy#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "compromise": "^14.15.1",
    "tokenshrink": "^2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
